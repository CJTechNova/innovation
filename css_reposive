/* =========================
   TABLET
========================== */

@media (max-width: 1000px) {

    .hero-content {
        grid-template-columns: 1fr;

        text-align: center;
    }

    .hero-badge {
        margin: 0 auto;
    }

    .hero-text > p {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-stats {
        justify-content: center;
    }

    .hero-product {
        margin-top: 20px;
    }

    .categories-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .products-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .benefits-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}


/* =========================
   MOBILE
========================== */

@media (max-width: 700px) {

    .navbar {
        height: 68px;
    }

    .nav-menu {
        position: absolute;

        top: 68px;
        left: 0;
        right: 0;

        display: none;

        flex-direction: column;

        padding: 20px;

        background: #080b12;

        border-bottom: 1px solid var(--color-border);
    }

    .nav-menu.active {
        display: flex;
    }

    .menu-button {
        display: grid;
        place-items: center;
    }

    .nav-actions .icon-button:nth-child(1),
    .nav-actions .icon-button:nth-child(3) {
        display: none;
    }

    .hero {
        min-height: auto;
    }

    .hero-content {
        padding: 70px 0;
    }

    .hero h1 {
        font-size: 48px;

        letter-spacing: -2.5px;
    }

    .hero-text > p {
        font-size: 15px;
    }

    .hero-stats {
        gap: 20px;
    }

    .hero-card {
        transform: none;
    }

    .hero-product-image {
        height: 220px;
    }

    .gpu-placeholder {
        width: 230px;
        height: 135px;
    }

    .section {
        padding: 70px 0;
    }

    .section-heading {
        align-items: flex-start;

        flex-direction: column;

        margin-bottom: 30px;
    }

    .categories-grid,
    .products-grid,
    .benefits-grid {
        grid-template-columns: 1fr;
    }

    .category-card {
        min-height: 210px;
    }

    .offer {
        padding: 40px 25px;

        min-height: 360px;
    }

    .offer-decoration {
        right: -100px;
        opacity: 0.5;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;

        gap: 35px;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }

    .footer-bottom {
        padding: 20px 0;

        flex-direction: column;

        justify-content: center;

        gap: 15px;

        text-align: center;
    }
}


/* =========================
   SMALL MOBILE
========================== */

@media (max-width: 420px) {

    .hero h1 {
        font-size: 40px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .button {
        width: 100%;
    }

    .hero-stats {
        gap: 15px;
    }

    .stat strong {
        font-size: 18px;
    }

    .stat span {
        font-size: 10px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }

    .footer-brand {
        grid-column: auto;
    }
}